// Schéma de données d'Atelier Manager (MLD : docs/bdd/mld.jpg).
// Chaque table appartient à un atelier : toute requête doit filtrer par workshop_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  member
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum WorksiteStatus {
  pending
  in_production
  ready
  delivered
  canceled
}

enum PhaseStatus {
  todo
  in_progress
  done
}

enum LineType {
  material
  labor
  service
  other
}

model Workshop {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  users     User[]
  clients   Client[]
  quotes    Quote[]
  worksites Worksite[]

  @@map("workshops")
}

model User {
  id           Int      @id @default(autoincrement())
  workshopId   Int      @map("workshop_id")
  workshop     Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole @default(member)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  phases       Phase[]

  @@index([workshopId])
  @@map("users")
}

model Client {
  id         Int        @id @default(autoincrement())
  workshopId Int        @map("workshop_id")
  workshop   Workshop   @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  code       String
  name       String
  isCompany  Boolean    @default(false) @map("is_company")
  email      String?
  phone      String?
  address    String?
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  quotes     Quote[]
  worksites  Worksite[]

  @@unique([workshopId, code])
  @@map("clients")
}

model Quote {
  id          Int         @id @default(autoincrement())
  workshopId  Int         @map("workshop_id")
  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  // RESTRICT : un client qui a un historique ne se supprime pas.
  clientId    Int         @map("client_id")
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reference   String
  title       String
  description String?
  status      QuoteStatus @default(draft)
  validUntil  DateTime?   @map("valid_until") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  lines       QuoteLine[]
  worksite    Worksite?

  @@unique([workshopId, reference])
  @@index([workshopId, status])
  @@index([clientId])
  @@map("quotes")
}

model QuoteLine {
  id        Int      @id @default(autoincrement())
  // CASCADE : une ligne n'a aucun sens sans son devis.
  quoteId   Int      @map("quote_id")
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position  Int
  type      LineType
  label     String
  quantity  Decimal  @db.Decimal(10, 2)
  unit      String
  // Prix et TVA copiés au moment du devis : un changement de tarif ne modifie pas un devis existant.
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  vatRate   Decimal  @map("vat_rate") @db.Decimal(4, 2)

  @@unique([quoteId, position])
  @@map("quote_lines")
}

model Worksite {
  id          Int            @id @default(autoincrement())
  workshopId  Int            @map("workshop_id")
  workshop    Workshop       @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  clientId    Int            @map("client_id")
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Un chantier vient toujours d'un devis, et un devis ne produit qu'un chantier.
  quoteId     Int            @unique @map("quote_id")
  quote       Quote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  reference   String
  title       String
  description String?
  // Vide : le chantier a lieu à l'adresse du client.
  siteAddress String?        @map("site_address")
  status      WorksiteStatus @default(pending)
  dueDate     DateTime?      @map("due_date") @db.Date
  // Date réelle de livraison : base du chiffre d'affaires du mois.
  deliveredAt DateTime?      @map("delivered_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  phases      Phase[]

  @@unique([workshopId, reference])
  @@index([workshopId, status])
  @@index([clientId])
  @@map("worksites")
}

model Phase {
  id             Int         @id @default(autoincrement())
  // CASCADE : une phase n'a aucun sens sans son chantier.
  worksiteId     Int         @map("worksite_id")
  worksite       Worksite    @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  // SET NULL : la phase survit au départ du membre affecté.
  assigneeId     Int?        @map("assignee_id")
  assignee       User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  position       Int
  name           String
  status         PhaseStatus @default(todo)
  estimatedHours Decimal     @map("estimated_hours") @db.Decimal(6, 2)
  actualHours    Decimal     @default(0) @map("actual_hours") @db.Decimal(6, 2)
  notes          String?

  @@unique([worksiteId, position])
  @@map("phases")
}
